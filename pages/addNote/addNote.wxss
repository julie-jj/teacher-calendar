.add-note-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form-section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.form-label.required::after {
  content: ' *';
  color: #F5222D;
}

.form-group input,
.form-group textarea {
  width: 100%;
  padding: 12rpx 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-group input:focus,
.form-group textarea:focus {
  border-color: #4A90E2;
  outline: none;
}

.picker-item {
  padding: 12rpx 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
  background-color: #fff;
}

/* 表单按钮 */
.form-buttons {
  display: flex;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.btn {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: white;
}

.btn-primary {
  background-color: #4A90E2;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
}
