.course-detail-container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.course-content {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  padding-bottom: 20rpx;
}

/* 课程头部 */
.course-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 25rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.course-type {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 信息分组 */
.info-section {
  padding: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #eee;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 24rpx;
  color: #666;
  min-width: 100rpx;
}

.value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
}

/* 备注 */
.notes-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
  word-wrap: break-word;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: white;
}

.btn-primary {
  background-color: #4A90E2;
}

.btn-danger {
  background-color: #F5222D;
}
