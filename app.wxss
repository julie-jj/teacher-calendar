/**app.wxss**/
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 颜色变量 */
.primary-color {
  color: #4A90E2;
}

.success-color {
  color: #52C41A;
}

.warning-color {
  color: #FAAD14;
}

.danger-color {
  color: #F5222D;
}

/* 通用样式 */
.container {
  padding: 20rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
  color: #333;
}

.card-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 按钮样式 */
.btn {
  padding: 15rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  outline: none;
  cursor: pointer;
  display: inline-block;
  text-align: center;
  transition: all 0.3s ease;
}

.btn-primary {
  background-color: #4A90E2;
  color: #fff;
}

.btn-primary:active {
  background-color: #357ABD;
}

.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
  border: 1rpx solid #ddd;
}

.btn-secondary:active {
  background-color: #e0e0e0;
}

.btn-danger {
  background-color: #F5222D;
  color: #fff;
}

.btn-danger:active {
  background-color: #d32f2f;
}

.btn-small {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

/* 输入框样式 */
input, textarea {
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 12rpx 15rpx;
  font-size: 28rpx;
  background-color: #fff;
}

input:focus, textarea:focus {
  border-color: #4A90E2;
  outline: none;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 6rpx 12rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-primary {
  background-color: #E6F4FF;
  color: #4A90E2;
}

.tag-success {
  background-color: #F6FFED;
  color: #52C41A;
}

.tag-warning {
  background-color: #FFFBE6;
  color: #FAAD14;
}

.tag-danger {
  background-color: #FFF1F0;
  color: #F5222D;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 20rpx;
  color: #999;
}

.empty-state-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state-text {
  font-size: 28rpx;
  text-align: center;
}

/* 加载动画 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 20rpx 0;
}

.divider-text {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  margin: 20rpx 0;
  position: relative;
}

.divider-text::before,
.divider-text::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 30%;
  height: 1rpx;
  background-color: #eee;
}

.divider-text::before {
  left: 0;
}

.divider-text::after {
  right: 0;
}
