/**
 * 全局样式
 */

/* 全局样式 */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 15rpx;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 弹性布局 */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* 空状态 */
.empty-state {
  padding: 60rpx 20rpx;
  text-align: center;
  color: #999;
}

.empty-state-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.empty-state-text {
  font-size: 26rpx;
  color: #999;
}

/* 按钮样式 */
button {
  background-color: #4A90E2;
  color: white;
  border: none;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

button.btn-primary {
  background-color: #4A90E2;
}

button.btn-secondary {
  background-color: #f0f0f0;
  color: #333;
}

button.btn-danger {
  background-color: #F5222D;
}

/* 输入框样式 */
input,
textarea {
  width: 100%;
  padding: 12rpx 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
  background-color: #fff;
  box-sizing: border-box;
}

input:focus,
textarea:focus {
  border-color: #4A90E2;
  outline: none;
}

/* 选择器 */
.picker {
  padding: 12rpx 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 26rpx;
}

/* 标签样式 */
label {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #eee;
  margin: 10rpx 0;
}

/* 文本颜色 */
.text-primary {
  color: #4A90E2;
}

.text-danger {
  color: #F5222D;
}

.text-success {
  color: #52C41A;
}

.text-warning {
  color: #FAAD14;
}

.text-disabled {
  color: #999;
}

/* 背景颜色 */
.bg-primary {
  background-color: #4A90E2;
}

.bg-danger {
  background-color: #F5222D;
}

.bg-success {
  background-color: #52C41A;
}

/* 间距 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.px-10 { padding: 0 10rpx; }
.px-20 { padding: 0 20rpx; }

/* 圆角 */
.rounded {
  border-radius: 8rpx;
}

.rounded-lg {
  border-radius: 12rpx;
}

/* 阴影 */
.shadow {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.shadow-lg {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

/* 响应式 */
@media (max-width: 320px) {
  page {
    font-size: 24rpx;
  }
}
